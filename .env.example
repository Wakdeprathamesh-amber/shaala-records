# Copy to .env.local and fill in. See docs/SETUP-SUPABASE.md
# Supabase → Connect → Session pooler (port 5432, IPv4-compatible)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Generate with: openssl rand -base64 48
SESSION_SECRET=""

NODE_ENV="development"
