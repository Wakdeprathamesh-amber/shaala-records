# Production environment for the self-hosted stack.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Then run the stack with BOTH flags — --env-file is not optional:
#
#   docker compose --env-file .env.production \
#                  -f docker-compose.selfhosted.yml up -d --build
#
# `env_file:` inside the compose file only passes variables into containers.
# It does NOT feed the ${...} substitutions the compose file itself uses, which
# are read from the shell or from --env-file. Omit the flag and compose stops
# with "required variable POSTGRES_PASSWORD is missing a value".
#
# This file holds live credentials. It is gitignored; keep it that way.

# ── Database ────────────────────────────────────────────────────────────────
# Used to build DATABASE_URL and to initialise Postgres on first boot.
# Generate: openssl rand -base64 32
POSTGRES_USER="shaala"
POSTGRES_PASSWORD=""
POSTGRES_DB="shaala"

# Only for docker-compose.prod.yml, where the database lives elsewhere. The
# self-hosted stack overrides this with the db container and ignores it.
# DATABASE_URL="postgresql://user:password@host:5432/postgres"

# ── Sessions ────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
#
# Changing this signs out every user at once, including mid-certificate. Treat
# it as permanent unless you are rotating it deliberately.
SESSION_SECRET=""

# ── Site ────────────────────────────────────────────────────────────────────
# Caddy requests a Let's Encrypt certificate for this name, so the DNS A record
# must already point at this server or the request fails and retries with a
# backoff that can take an hour to clear.
SHAALA_DOMAIN="shaala.example.org"
SHAALA_TLS_EMAIL="you@example.org"

NODE_ENV="production"

# ── Off-box backups (Cloudflare R2) ─────────────────────────────────────────
# Leave blank and backups stay on the same disk as the database — which is no
# backup at all the day the disk or the instance goes. Oracle terminates idle
# Always Free instances, boot volume included.
#
# R2 → Manage API tokens → Object Read & Write, scoped to this bucket.
R2_BUCKET=""
R2_ENDPOINT=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="auto"
