# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the templates, which carry placeholders only and are the
# documentation for deploying this. `.env*` swallowed .env.production.example
# silently, so a deployment guide shipped without the file it refers to.
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env.local
.env

# build output
/uploads

# but do commit the template
!.env.example

# local PDF previews, not part of the app
/public/_preview
