      "source": "enrollment.class",
      "required": true
    },
    {
      "header": "Section",
      "source": "enrollment.division",
      "required": false
    },
    {
      "header": "Roll Number",
      "source": "enrollment.rollNo",
      "required": false
    },
    {
      "header": "Admission Number",
      "source": "student.grNumber",
      "required": true
    },
    {
      "header": "Admission Date",
      "source": "student.admissionDate",
      "required": true,
      "transform": "date:DD/MM/YYYY"
    },
    {
      "header": "Aadhaar Verified",
      "source": "student.aadhaarVerified",
      "required": false,
      "transform": "map:yesNo"
    },
    {
      "header": "Blood Group",
